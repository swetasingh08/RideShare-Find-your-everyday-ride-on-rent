# Local development uses the local backend. In Vercel Project Settings, replace
# this with the deployed backend URL (not the frontend URL) if they are separate.
VITE_BASE_URL=http://localhost:3000
# Browser key for Google Maps JavaScript API; restrict by HTTP referrer in Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_ORG_SLUG=car-rental
VITE_CLERK_SIGN_IN_URL=/sign-in
VITE_CURRENCY=₹
